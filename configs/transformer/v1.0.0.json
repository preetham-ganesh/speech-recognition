{
  "dataset": {
    "name": "librispeech",
    "size": "mini",
    "version": "1.0.0"
  },
  "optimizer": {
    "learning_rate": 0.0003,
    "warmup_steps": 8000,
    "beta_1": 0.9,
    "beta_2": 0.98,
    "epsilon": 1e-9
  },
  "model": {
    "architecture": "transformer",
    "type": "base",
    "epochs": 50,
    "batch_size": 16,
    "max_input_length": 2754,
    "n_bins": 129,
    "d_units": 128,
    "ff_units": 512,
    "n_heads": 2,
    "n_layers": 1,
    "target_vocab_size": 29,
    "target_max_length": 100,
    "rate": 0.1,
    "patience_count": 3
  }
